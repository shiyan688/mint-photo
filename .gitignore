# Full photo projects are private by default. These two reviewed test inputs contain
# only tiny synthetic PNG data and must remain available to JS/JVM boundary tests.
*.mintproject
!tests/fixtures/project-backup/minimal-v2.mintproject
!tests/fixtures/project-backup/legacy-v1.mintproject

# Historical QA media can contain portraits whose archive is restricted to private QA.
# Keep quality/ source, arithmetic metadata, and independent oracles; omit raster outputs.
/quality/**/*.png
/quality/**/*.jpg
/quality/**/*.jpeg
/quality/**/*.webp
/quality/**/*.gif
/quality/**/*.bmp
/quality/**/*.tif
/quality/**/*.tiff
/quality/**/*.avif
/quality/**/*.heic
/quality/**/*.heif
/quality/**/*.rgba
/quality/**/*.gz
/quality/**/*.npy
/quality/**/*.npz
/quality/**/*.mp4
/quality/**/*.mov
/quality/**/*.pdf

# These JSON files contain full masks derived from the same private-QA portrait.
/quality/mask-refine-evidence/comparison-zh.json
/quality/mask-refine-evidence/public-host-model-mask.json
/quality/mask-refine-evidence/public-refinement-recipe.json

# Private delivery IDs and historical machine-local reports, not product source.
/quality/archives/v29-baseline-manifest.json
/quality/archives/v30-increment-manifest.json
/quality/beauty-protection-evidence/library-evidence.json
/quality/beauty-protection-evidence/restored-source-verification.json
/quality/beauty-protection-independent/results.json
/quality/manual-deformation-evidence/clean-restore-validation.json
/quality/sharpness-evidence/delivery-manifest.json
/quality/sharpness-evidence/comparison-zh.json
/quality/**/*.txt
*.tap
/engine-test-results.json
/interaction-test-results.json
/project-workflow-test-results.json
/tests/model-fixture-results/*.txt
/tests/model-fixture-results/astronaut-analysis.json
/tests/audit/**/results/
/tests/native-canvas/results/

# Archive-specific local tools are retained on disk, but contain private delivery pins
# or package files outside the public Git allowlist. Public releases use git archive.
/tools/restore-quality-baseline.py
/tests/quality-baseline.test.py
/tools/package-source.py
/tests/package-source.test.py

